FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /workspace

COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline

COPY src ./src
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /workspace/target/offer-service-0.0.1-SNAPSHOT.jar /app/offer-service.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/offer-service.jar"]
